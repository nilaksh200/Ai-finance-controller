.cloud_rotation_state
*.tmp

# --- Python ---
__pycache__/
*.py[cod]
*.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.eggs/

# --- Virtual Environments ---
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- IDE & Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Test & Coverage ---
.pytest_cache/
.coverage
htmlcov/
